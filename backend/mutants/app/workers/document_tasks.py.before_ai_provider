from uuid import UUID

from app.core.database import SessionLocal
from app.integrations.storage import download_bytes
from app.repositories.document_processing_job_repository import (
    get_processing_job,
)
from app.repositories.document_repository import (
    get_document_version,
)
from app.services.document_processing_service import (
    complete_document_processing,
    fail_document_processing,
    start_document_processing,
)
from app.services.document_text_extraction_service import (
    extract_pdf_text,
)
from app.workers.celery_app import celery_app

from app.services.document_analysis_service import (
    create_document_analysis,
)


@celery_app.task
def process_document_task(
    version_id: str,
    job_id: str,
) -> dict:
    db = SessionLocal()

    try:
        version = get_document_version(
            db,
            UUID(version_id),
        )

        if version is None:
            raise ValueError(
                "Document version not found"
            )

        job = get_processing_job(
            db,
            UUID(job_id),
        )

        if job is None:
            raise ValueError(
                "Document processing job not found"
            )

        start_document_processing(
            db,
            job,
        )
        db.commit()
        db.refresh(job)

        file_bytes = download_bytes(
            version.storage_key
        )

        extracted = extract_pdf_text(
            file_bytes
        )

        create_document_analysis(
            db=db,
            document_version_id=version.id,
            extracted=extracted,
        )

        complete_document_processing(
            db,
            job,
            version,
        )

        db.commit()

        return {
            "version_id": version_id,
            "job_id": job_id,
            "page_count": extracted.page_count,
            "has_text": extracted.has_text,
            "text_length": len(extracted.full_text),
            "status": "COMPLETED",
        }

    except Exception as exc:
        db.rollback()

        version = get_document_version(
            db,
            UUID(version_id),
        )

        job = get_processing_job(
            db,
            UUID(job_id),
        )

        if (
            version is not None
            and job is not None
            and job.status == "PROCESSING"
        ):
            fail_document_processing(
                db,
                job,
                version,
                str(exc),
            )
            db.commit()

        raise

    finally:
        db.close()