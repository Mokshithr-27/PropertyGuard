# ==============================================================================
# PropertyGuard - Environment Configuration Template (.env.example)
# Defines required environment variables for database, caching, object storage,
# JWT secret keys, and AI provider configurations (Gemini/Mock/Ollama).
# ==============================================================================

APP_NAME=PropertyGuard
ENVIRONMENT=development
SECRET_KEY=replace_with_secure_secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/propertyguard
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET_NAME=propertyguard
